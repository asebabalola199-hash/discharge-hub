# Copy this file to backend/.env for local development (it's gitignored).
# On Render, set these as real environment variables in the service's
# Environment tab instead of a .env file.
#
# Leave any of these unset/blank and real telephony simply stays disabled —
# the app falls back to the scripted demo check-in exactly as before.

# --- Twilio (twilio.com) — an account is required to place any real call --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number calls are placed FROM. Either:
#   (a) a Twilio-purchased number (~$1/mo), or
#   (b) your OWN mobile number, once verified as an Outgoing Caller ID in
#       the Twilio console (Phone Numbers -> Verified Caller IDs) — this
#       avoids the number-rental cost. Twilio account + usage fees still
#       apply either way; there's no way to place a real call onto the
#       phone network without going through some paid telephony provider.
# E.164 format, e.g. +447700900123
TWILIO_PHONE_NUMBER=

# --- Groq (console.groq.com) — free tier, drives the live conversation ---
# No card required. Fast (matters for live back-and-forth on a real call).
GROQ_API_KEY=

# --- Public URL Twilio uses to reach this server's webhooks --------------
# Must be the real, internet-reachable https URL of THIS deployment.
# localhost will not work — Twilio cannot reach your machine directly.
PUBLIC_BASE_URL=            # e.g. https://discharge-hub-xxxx.onrender.com
